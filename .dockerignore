# Keep credentials and local state out of every build context.
.git
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
service-account*.json
.venv
**/__pycache__
**/*.pyc
.pytest_cache
.coverage
htmlcov
artifacts
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.log
**/.DS_Store
frontend/node_modules
frontend/.angular
frontend/dist
frontend/test-results
frontend/playwright-report
