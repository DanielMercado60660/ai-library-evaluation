# Copy to .env for local development. Never commit your .env file.
# Only live Gemini chat/evaluation needs a real key; offline tests do not.
GOOGLE_API_KEY=

# Use a model available to your Gemini account; the runtime default is below.
MODEL_NAME=gemini-3-flash-preview

# Service URLs for local processes (Docker Compose overrides these internally).
CATALOG_URL=http://localhost:8001
CIRCULATION_URL=http://localhost:8002
RECOMMENDATION_URL=http://localhost:8003
AUTH_URL=http://localhost:8004

# Each local service should receive its own DATABASE_URL.
DATABASE_URL=sqlite:///./library.db

# Public development fixture, used across services and the local frontend.
# This is not a production credential or user authentication system.
SERVICE_AUTH_TOKEN=dev-token-ai-librarian

# Keep shortcuts disabled when measuring live model behavior.
EVAL_SHORTCUTS_ENABLED=false
